PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Banco de dados PostgreSQL (ex: PostgreSQL local, Neon ou Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiwii

# Redis (opcional em dev — se omitido ou inacessível, o servidor usa fallback em memória automaticamente)
# REDIS_URL=redis://localhost:6379

# Supabase Auth (obtido no painel do Supabase: Settings -> API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# JWT interno para tokens de atendimento dos clientes
JWT_SECRET=dev_secret_trocar_em_producao
JWT_EXPIRES_IN=8h
